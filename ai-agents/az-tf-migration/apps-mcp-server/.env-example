# Example environment variables for Azure-Terraform MCP Server

# PowerShell Script Paths
POWERSHELL_SCRIPT_PATH=./ps/assessment-AzSubscription.ps1
EXPORT_SCRIPT_PATH=./ps/Export-AzToTerraform.ps1
REFACTOR_SCRIPT_PATH=./python/refactor.py

# Azure Authentication (Service Principal)
AZURE_CLIENT_ID=example-client-id
AZURE_CLIENT_SECRET=example-client-secret
AZURE_TENANT_ID=example-tenant-id

# Server Configuration
STDIO_MODE=false
PORT=3000
PUBLIC_HOST=example-host.azurecontainerapps.io
PUBLIC_PROTOCOL=https

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_CORRELATION_ID=true

# Azure Configuration
storageAccountRG=example-rg
storageAccount=example-storage

# Output Destination Configuration
OUTPUT_DESTINATION=both

# GitHub Configuration
GITHUB_TOKEN=ghp_exampletoken
GITHUB_OWNER=example-owner
GITHUB_REPO=example-repo
GITHUB_BRANCH=main

# Output Folders
ASSESSMENT_FOLDER=assessment-reports
AZTFEXPORT_FOLDER=aztfexport
CODE_REFACTORED_FOLDER=code-refactored

# Logging
LOG_LEVEL=info

# Paths to JSON configuration files
EXCLUDE_JSON_PATH=../json/exclude.json
AZ_TO_TERRAFORM_MAPPINGS_PATH=../json/AzToTerraformMappings.json
TERRAFORM_MAPPING_PATH=../json/terraform-mapping.json
