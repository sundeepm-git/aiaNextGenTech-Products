}

# Check if user is logged in to Azure, else try SPN login if env vars are set
try {
    $accountJson = az account show --output json 2>&1
    if ($LASTEXITCODE -ne 0) {
        $clientId = $env:AZURE_CLIENT_ID
        $clientSecret = $env:AZURE_CLIENT_SECRET
        $tenantId = $env:AZURE_TENANT_ID
        if ($clientId -and $clientSecret -and $tenantId) {
            $null = az login --service-principal -u $clientId -p $clientSecret --tenant $tenantId 2>&1
            if ($LASTEXITCODE -ne 0) {
                throw "Service Principal login failed"
            }
        } else {
            throw "Not logged in to Azure. Set AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, AZURE_TENANT_ID or run 'az login'"
        }
    }
}
catch {
    Write-Host ""
    Write-Host ('=' * 80) -ForegroundColor Red
    Write-Host "  ERROR: Azure Authentication Failed" -ForegroundColor Red
    Write-Host ('=' * 80) -ForegroundColor Red
    Write-Host "  $($_.Exception.Message)" -ForegroundColor Yellow
    Write-Host "  Solution: az login" -ForegroundColor Gray
    Write-Host ('=' * 80) -ForegroundColor Red
