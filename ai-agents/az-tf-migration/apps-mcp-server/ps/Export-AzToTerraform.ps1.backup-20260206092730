    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Azure to Terraform Export Report</h1>
            <p>Resource Group: $ResourceGroupName</p>
        </div>
        
        <div class="content">
            <!-- Export Information Section -->
            <div class="section">
                <div class="section-title">Export Information</div>
                <div class="info-grid">
                    <div class="info-item">
